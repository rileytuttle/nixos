# home-manager module for claude-container (pkgs/claude-container).
#
# The package on its own already works -- `nix run .#claude-container` from
# anywhere. This module exists for the two things a package cannot do: put it
# on PATH for a user, and bake per-machine defaults (runtime, where the
# container's HOME lives, standing mounts) into the command so they do not
# have to be typed every time.
#
# Defaults are applied through a wrapper script rather than a config file so
# that an explicit flag on the command line still wins -- the defaults go in
# front of "$@", and claude-container's own parser takes the last word.
{
  config,
  lib,
  pkgs,
  ...
}@args:
let
  cfg = config.programs.claude-container;

  # Pin the container's nixpkgs to the same rev the host is built from, when
  # the flake passed its inputs in (fw12 and rt-dellpromax-24 both do, via
  # extraSpecialArgs). Standalone home-manager without `inputs` falls back to
  # tracking nixos-unstable, which the package handles.
  nixpkgsRev = args.inputs.nixpkgs.rev or null;

  defaultPackage = import ../pkgs/claude-container { inherit pkgs nixpkgsRev; };

  # The flags this module turns into defaults.
  defaultArgs =
    lib.optionals (cfg.runtime != null) [
      "--runtime"
      cfg.runtime
    ]
    ++ lib.optionals (cfg.stateDir != null) [
      "--home"
      cfg.stateDir
    ]
    ++ lib.optionals cfg.skipPermissions [ "--skip-permissions" ]
    ++ lib.optionals cfg.forwardSshAgent [ "--ssh-agent" ]
    ++ lib.concatMap (d: [
      "--mount"
      d
    ]) cfg.extraMounts
    ++ lib.concatMap (d: [
      "--mount-ro"
      d
    ]) cfg.extraReadOnlyMounts
    ++ cfg.extraArgs;

  wrapped =
    if defaultArgs == [ ] then
      cfg.package
    else
      pkgs.writeShellScriptBin "claude-container" ''
        # Generated by home/claude-container.nix -- edit that, not this.
        exec ${cfg.package}/bin/claude-container ${lib.escapeShellArgs defaultArgs} "$@"
      '';

  # A short name reaches the *wrapped* command, so an alias still gets the
  # module's defaults.
  aliasFor =
    name:
    pkgs.writeShellScriptBin name ''
      # Generated by home/claude-container.nix -- edit that, not this.
      exec ${wrapped}/bin/claude-container "$@"
    '';
in
{
  options.programs.claude-container = {
    enable = lib.mkEnableOption "Claude Code in a container with its own nix store";

    package = lib.mkOption {
      type = lib.types.package;
      default = defaultPackage;
      defaultText = lib.literalExpression "pkgs/claude-container, pinned to this flake's nixpkgs";
      description = "The claude-container package to install.";
    };

    runtime = lib.mkOption {
      type = lib.types.nullOr (
        lib.types.enum [
          "podman"
          "docker"
        ]
      );
      default = null;
      description = ''
        Container runtime to use. Null lets claude-container pick whichever of
        podman and docker is on PATH.

        Prefer podman where you have it: rootless podman maps container root to
        your own uid, so the container owns its /nix *and* writes workspace
        files as you. Under a rootful docker daemon the entrypoint has to drop
        to your uid instead and chown the store once per volume -- it works,
        it is just a slower first run.
      '';
    };

    stateDir = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "/home/me/.local/share/claude-container/home";
      description = ''
        Host directory used as the container's HOME. This is where the
        container's ~/.claude lives -- credentials, sessions, and the profile
        symlinks for anything Claude installed with nix. Null uses
        claude-container's own default under $XDG_DATA_HOME.
      '';
    };

    skipPermissions = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Always pass --dangerously-skip-permissions to claude inside the
        container. Reasonable here in a way it is not on the host -- the
        container, and the read-write mounts you chose, are the boundary --
        but it does mean Claude runs commands in there without asking.
      '';
    };

    forwardSshAgent = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Forward $SSH_AUTH_SOCK into the container, so git can push.";
    };

    extraMounts = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "/home/me/scratch" ];
      description = "Directories always mounted read-write, besides the workspace.";
    };

    extraReadOnlyMounts = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "/home/me/reference" ];
      description = "Directories always mounted read-only.";
    };

    extraArgs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "--runtime-arg=--network=host" ];
      description = "Any other claude-container flags to default to.";
    };

    aliases = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "claude-c" ];
      description = ''
        Extra names to reach claude-container by.

        Being on PATH, these shadow anything of the same name further down it
        -- which is why neither host calls this `cc`: that is the C compiler
        on any machine with gcc installed, and home.packages comes before
        /usr/bin.

        They install as one-line scripts on PATH, not as
        programs.bash.shellAliases, so that they work on a host whose .bashrc
        home-manager does not own -- rt-dellpromax-24 uses Ubuntu's own (see
        the note in home/balena.nix). They cannot go in ~/.bash_aliases
        either: home/balena.nix already claims that file, and two modules
        writing one home.file target is an eval error.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.packages = [ wrapped ] ++ map aliasFor cfg.aliases;
  };
}
