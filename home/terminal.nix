# The one place that decides which terminal emulator this machine uses.
#
# Everything that opens a terminal spawns `terminal` -- the niri Mod+T bind,
# the kakoune notepad toggle, anything typed at a prompt -- and never konsole
# by name. Swapping emulators is then an edit to this one file instead of a
# grep across .kdl and .sh files that no rebuild would catch, because nothing
# in a window-manager config or a shell script is type-checked at build time.
#
# Note that none of this touches the shell environment: the emulator only
# execs your login shell, and bash is what reads ~/.bashrc (see the
# programs.bash block in home/core.nix). Changing emulators cannot change
# your aliases or prompt.
#
# Imported by home/apps-personal.nix (it is a GUI app, and a headless host
# taking only core.nix has no use for it) and, separately, by home/niri.nix:
# niri's Mod+T depends on `terminal` existing, so the niri module declares
# that dependency itself rather than assuming the host also took
# home/default.nix -- rt-dellpromax-24 doesn't. Importing the same module
# from two places is a no-op in nix; the second import dedupes by path.
{ pkgs, ... }:

let
  # ---- The emulator. This is the swap point. ------------------------------
  exe = "${pkgs.kdePackages.konsole}/bin/konsole";

  # Flags that give the window a title. konsole has no --title: its window
  # title comes from the profile's tab-title *format*, which defaults to
  # "%d : %n" and ignores whatever the program inside the terminal sets, so
  # an escape-sequence title would be dropped on the floor. Overriding
  # tabtitle with a literal is what actually makes the title stick -- which
  # is what the kak-notepad window rule in niri-config.kdl matches on.
  #
  # "$title" here is a shell variable in the generated script, not a nix
  # interpolation; nix only expands ''${...}, never a bare $name.
  titleArgs = ''-p "tabtitle=$title"'';

  # The flag after which everything is the command to run inside the terminal.
  execArgs = "-e";
  # ------------------------------------------------------------------------
in
{
  home.packages = [
    (pkgs.writeShellScriptBin "terminal" ''
      # Generated by home/terminal.nix -- edit that, not this.
      #
      #   terminal                                 an interactive shell
      #   terminal --title NAME                    ...with a fixed window title
      #   terminal [--title NAME] -- CMD [ARG...]  run CMD inside it
      #
      # The whole point is that callers speak this one CLI, so swapping the
      # emulator above is the only edit a swap needs.
      set -euo pipefail

      title=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --title) title="$2"; shift 2 ;;
          --title=*) title="''${1#--title=}"; shift ;;
          --) shift; break ;;
          *) break ;;
        esac
      done

      args=()
      if [ -n "$title" ]; then
        args+=( ${titleArgs} )
      fi
      if [ "$#" -gt 0 ]; then
        args+=( ${execArgs} "$@" )
      fi

      exec ${exe} "''${args[@]}"
    '')
  ];
}
