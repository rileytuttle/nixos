<?xml version="1.0" encoding="UTF-8" ?>

<!--
  Classic Bluetooth HID Device SDP record for a boot-protocol keyboard.
  Advertises two L2CAP channels:
    - Control PSM   0x0011 (attribute 0x0004, ProtocolDescriptorList)
    - Interrupt PSM 0x0013 (attribute 0x000d, AdditionalProtocolDescriptorLists)
  The HIDDescriptorList (0x0206) below is the standard USB HID "Appendix B.1"
  boot keyboard report descriptor: 1 modifier byte + 1 reserved byte + 6
  keycode bytes, no report ID. This MUST match the 8-byte report format sent
  by hid_server.py over the interrupt channel.
-->
<record>
  <attribute id="0x0001">
    <sequence>
      <uuid value="0x1124" /> <!-- HID service class -->
    </sequence>
  </attribute>

  <attribute id="0x0004">
    <sequence>
      <sequence>
        <uuid value="0x0100" /> <!-- L2CAP -->
        <uint16 value="0x0011" /> <!-- Control PSM -->
      </sequence>
      <sequence>
        <uuid value="0x0011" /> <!-- HIDP -->
      </sequence>
    </sequence>
  </attribute>

  <attribute id="0x0005">
    <sequence>
      <uuid value="0x1002" /> <!-- PublicBrowseGroup -->
    </sequence>
  </attribute>

  <attribute id="0x0006">
    <sequence>
      <uint16 value="0x656e" />
      <uint16 value="0x006a" />
      <uint16 value="0x0100" />
    </sequence>
  </attribute>

  <attribute id="0x0009">
    <sequence>
      <sequence>
        <uuid value="0x1124" />
        <uint16 value="0x0100" />
      </sequence>
    </sequence>
  </attribute>

  <attribute id="0x000d">
    <sequence>
      <sequence>
        <sequence>
          <uuid value="0x0100" /> <!-- L2CAP -->
          <uint16 value="0x0013" /> <!-- Interrupt PSM -->
        </sequence>
        <sequence>
          <uuid value="0x0011" /> <!-- HIDP -->
        </sequence>
      </sequence>
    </sequence>
  </attribute>

  <!-- ServiceName. @DEVICE_NAME@ is substituted by hid_server.py at
       registration time (XML-escaped) so the name follows the host's
       hostname instead of being baked in here. -->
  <attribute id="0x0100">
    <text value="@DEVICE_NAME@" />
  </attribute>

  <attribute id="0x0101">
    <text value="Emulated Bluetooth keyboard (bt-kb-emulator)" />
  </attribute>

  <attribute id="0x0102">
    <text value="bt-kb-emulator" />
  </attribute>

  <attribute id="0x0200"> <!-- HIDDeviceReleaseNumber (legacy, deprecated) -->
    <uint16 value="0x0100" />
  </attribute>

  <attribute id="0x0201"> <!-- HIDParserVersion -->
    <uint16 value="0x0111" />
  </attribute>

  <attribute id="0x0202"> <!-- HIDDeviceSubclass: 0x40 = keyboard -->
    <uint8 value="0x40" />
  </attribute>

  <attribute id="0x0203"> <!-- HIDCountryCode: 0x21 = US -->
    <uint8 value="0x21" />
  </attribute>

  <attribute id="0x0204"> <!-- HIDVirtualCable -->
    <boolean value="true" />
  </attribute>

  <attribute id="0x0205"> <!-- HIDReconnectInitiate -->
    <boolean value="true" />
  </attribute>

  <attribute id="0x0206"> <!-- HIDDescriptorList -->
    <sequence>
      <sequence>
        <uint8 value="0x22" /> <!-- descriptor type: Report -->
        <text encoding="hex" value="05010906a101050719e029e71500250175019508810295017508810195057501050819012905910295017503910195067508150025650507190029658100c0" />
      </sequence>
    </sequence>
  </attribute>

  <attribute id="0x0207"> <!-- HIDLANGIDBaseList -->
    <sequence>
      <sequence>
        <uint16 value="0x0409" /> <!-- English (US) -->
        <uint16 value="0x0100" />
      </sequence>
    </sequence>
  </attribute>

  <attribute id="0x020b"> <!-- HIDProfileVersion -->
    <uint16 value="0x0100" />
  </attribute>

  <attribute id="0x020c"> <!-- HIDSupervisionTimeout -->
    <uint16 value="0x0c80" />
  </attribute>

  <attribute id="0x020d"> <!-- HIDNormallyConnectable -->
    <boolean value="true" />
  </attribute>

  <attribute id="0x020e"> <!-- HIDBootDevice -->
    <boolean value="true" />
  </attribute>
</record>
