# plugins
#
# There is no plugin manager here. modules/kakoune.nix builds fzf.kak,
# openscad.kak and kakoune-sudo-write into the editor, where kakoune autoloads
# them -- so this file only carries their settings, not their installation.
# plug.kak used to `git clone` into ~/.config/kak/plugins on first start, which
# meant the editor needed the network to come up correctly and new machines
# needed a manual `:plug-install`. `nix flake update` is what bumps them now.

define-command -docstring "sudo-write alias" W %{
    sudo-write
}
# Wq doesn't work because the script doesn't wait for sudo write to finish before quitting
define-command -docstring "sudo-write quit alias" Wq %{
    sudo-write
    quit
}

# fzf.kak. Its options are declared by the modules that use them, so they can
# only be set once those have loaded -- which is exactly what plug.kak's
# `defer <module>` expanded to (see the ModuleLoaded line in its plug.sh).
map global normal <c-p> ': fzf-mode<ret>' -docstring 'enter fzf-mode'
hook global ModuleLoaded fzf %{
    set-option global fzf_default_opts '--layout=reverse'
    set-option global fzf_use_main_selection false
    # A height with a `%' makes fzf.kak pick `tmux split-window -p', which tmux
    # removed. A plain line count takes the `-l' path and works. This is the
    # whole reason there used to be a fzf.kak fork.
    set-option global fzf_tmux_height 25
}
hook global ModuleLoaded fzf-file %{
    set-option global fzf_file_command 'find'
}

