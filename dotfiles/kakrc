# Line selection, the way it worked before upstream dropped select_line.
# These used to be two C++ patches in a kakoune fork; they are plain config
# now, so nix can install the stock editor. Today's builtin `x` only extends
# a selection to whole lines and is idempotent, so holding it goes nowhere.
#
#   x  select the cursor's line; already on a whole line -> take the next one
#   X  same, but grow the selection instead of replacing it
#
# Arriving on an empty line the selection IS already the whole line, so the
# next `x` moves on -- which is what you want. `j` is a no-op on the last
# line, so `x` stops at the end of the buffer.
#
# $1 selects the starting line, $2 advances one line. execute-keys ignores
# user mappings by default, so the `x` in there is the builtin, not this
# command -- no recursion.
define-command -hidden rt-line-impl -params 2 %{
    evaluate-commands %sh{
        nl='
'
        count=${kak_count:-0}
        [ "$count" -lt 1 ] && count=1
        a=${kak_selection_desc%,*}
        c=${kak_selection_desc#*,}
        al=${a%.*}
        ac=${a#*.}
        cl=${c%.*}
        cc=${c#*.}
        # leftmost end of the selection, whichever way it points
        if [ "$al" -lt "$cl" ] || { [ "$al" -eq "$cl" ] && [ "$ac" -le "$cc" ]; }; then
            start_col=$ac
        else
            start_col=$cc
        fi
        # Not on whole lines yet? Select the current line and spend one of the
        # count on it. "Whole lines" means starting at column 1 and running
        # through the trailing newline -- the column test is what keeps `gl`
        # followed by `x` on the current line instead of skipping it.
        if [ "$start_col" != 1 ] || [ "${kak_selection%"$nl"}" = "$kak_selection" ]; then
            printf "execute-keys '%s'\n" "$1"
            count=$((count - 1))
        fi
        if [ "$count" -gt 0 ]; then
            printf "execute-keys '%s'\n" "$count$2"
        fi
    }
}
define-command -hidden rt-select-line %{ rt-line-impl ';x' 'jx' }
define-command -hidden rt-extend-line %{ rt-line-impl 'x' 'Jx' }

map global normal x ': rt-select-line<ret>'
map global normal X ': rt-extend-line<ret>'

# Pre-fill the search prompt with the selection, so <ret> on an empty prompt
# searches what's selected rather than repeating the last search. The other
# half of what the fork used to patch into regex_prompt.
#
# The register is written before the prompt opens, so escaping out of the
# prompt still leaves the last search set to the selection -- the fork only
# wrote it on validate. Use <a-*> instead if a selection ever needs escaping
# as a regex; it quotes the metacharacters.
map global normal / ': set-register slash %val{selection}<ret>/'

