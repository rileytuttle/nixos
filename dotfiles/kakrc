# plugins
#
# There are none. What fzf.kak, kakoune-sudo-write and openscad.kak used to do
# is written out below, and per-language smarts come from kakoune-lsp (the
# "lsp" section at the bottom). pkgs/kakoune.nix supplies every program this
# file shells out to.

# sudo
#
# Replaces the kakoune-sudo-write plugin. Open a file you can read but not
# write (or a new file in a directory you can't write) and the buffer is
# tagged [no write perm] in the modeline. You can edit it; `:w` / `:wq` then
# elevate the way a CLI does: if sudo still has cached credentials it just
# writes, otherwise you get a "[sudo] password for <you>:" prompt in the
# status line (<esc> cancels, and nothing is written). `:W` / `:Wq` force a
# sudo write on any buffer.
#
# Deliberately not kakoune's `readonly` option: in this kakoune that blocks
# editing the buffer at all ("buffer is read-only"), not just saving it.
#
# Why this shape:
#   - The write is synchronous, so `:wq` / `:Wq` really do wait for it. The
#     plugin's Wq quit before the password prompt was even answered.
#   - The typed password never touches the environment or a command line:
#     the shell reads it from kakoune through $kak_response_fifo into a shell
#     variable, and hands it to `sudo -S` on stdin with printf (a builtin, so
#     no argv either).
#   - The file is rewritten in place with `dd of=`, so it keeps its owner and
#     mode.
#   - A file you can't even read never gets here: kakoune refuses to open it
#     (you land in *scratch* with "Permission denied" in *debug*), so there is
#     no empty buffer that could be sudo-written over the real file.

declare-option -hidden bool rt_sudo_needed false

define-command -hidden rt-sudo-check %{ evaluate-commands %sh{
    f=$kak_buffile
    case $f in /*) ;; *) exit 0 ;; esac   # scratch/fifo buffers
    if [ -e "$f" ]; then
        [ -w "$f" ] && exit 0
    else
        d=$(dirname -- "$f")
        { [ ! -d "$d" ] || [ -w "$d" ]; } && exit 0
    fi
    echo 'set-option buffer rt_sudo_needed true'
    echo 'set-option buffer modelinefmt "{Error}[no write perm]{Default} %opt{modelinefmt}"'
}}
hook global BufOpenFile .* rt-sudo-check
hook global BufNewFile .* rt-sudo-check

# rt-sudo-write [quit]: sudo-write the current buffer, prompting for the
# password only if sudo has no cached credentials (or needs none).
define-command -hidden -params ..1 rt-sudo-write %{ evaluate-commands %sh{
    kq() { printf "'%s'" "$(printf %s "$1" | sed "s/'/''/g")"; }
    case $kak_buffile in /*) ;; *) echo "fail 'not a file buffer'"; exit 0 ;; esac
    if sudo -n true 2>/dev/null; then
        echo "rt-sudo-write-impl cached $1"
    else
        printf 'prompt -password %s %s\n' \
            "$(kq "[sudo] password for $(id -un): ")" \
            "$(kq "rt-sudo-write-impl password $1")"
    fi
}}

# rt-sudo-write-impl <cached|password> [quit]. `password` is only valid from
# inside the prompt above, where %val{text} holds what was typed.
define-command -hidden -params 1..2 rt-sudo-write-impl %{
    evaluate-commands -save-regs f %{
        # Stage the buffer through kakoune's own writer, so eolformat, BOM and
        # BufWritePre hooks behave exactly like a normal :w.
        set-register f %sh{ mktemp "${TMPDIR:-/tmp}/kak-sudo.XXXXXX" }
        try %{
            write -force %reg{f}
        } catch %{
            nop %sh{ rm -f "$kak_main_reg_f" }
            fail 'sudo write: could not stage the buffer to a temp file'
        }

        evaluate-commands %sh{
            kq() { printf "'%s'" "$(printf %s "$1" | sed "s/'/''/g")"; }
            tmp=$kak_main_reg_f
            target=$kak_buffile
            err=$(mktemp "${TMPDIR:-/tmp}/kak-sudo-err.XXXXXX")
            if [ "$1" = password ]; then
                printf 'echo -to-file %s %%val{text}\n' "$(kq "$kak_response_fifo")" >"$kak_command_fifo"
                pw=$(cat "$kak_response_fifo")
                printf '%s\n' "$pw" | sudo -S -p '' -- dd if="$tmp" of="$target" status=none 2>"$err"
                status=$?
                pw=
            else
                sudo -n -- dd if="$tmp" of="$target" status=none 2>"$err"
                status=$?
            fi
            msg=$(grep -v '^$' "$err" | tail -n 1)
            rm -f "$tmp" "$err"
            if [ "$status" -ne 0 ]; then
                printf 'fail %s\n' "$(kq "sudo write failed: ${msg:-exit $status}")"
                exit 0
            fi
            # Reload what is now on disk: clears the modified flag and shows
            # exactly what root wrote.
            echo 'edit!'
            printf 'echo -markup %s\n' "$(kq "{Information}\"$target\" written with sudo")"
            [ "$2" = quit ] && echo 'quit'
        }
    }
}

define-command -hidden -params .. rt-write %{ evaluate-commands %sh{
    if [ "$kak_opt_rt_sudo_needed" = true ] && [ $# -eq 0 ]; then
        echo 'rt-sudo-write'
    else
        echo 'write %arg{@}'
    fi
