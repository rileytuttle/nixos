#| ---------------------------------------------------------------------------
LAYOUT ONLY -- no (defcfg) here. Deliberately.

kanata's (defcfg) block holds the host-specific bits: which evdev devices to
grab (linux-dev) and what to do when none of them exist. This file is shared
by every host, so it carries none of that -- it is defsrc/deflayer/defalias
and nothing else. The defcfg is generated per-host by nix and prepended:

  fw12 (NixOS)              modules/kanata.nix, via services.kanata.keyboards
  rt-dellpromax-24 (Ubuntu) home/kanata-generic-linux.nix

That split is the whole point. This file used to pin
  linux-dev /dev/input/by-path/platform-i8042-serio-0-event-kbd
which is fw12's internal i8042 keyboard, so the layout could not be used on
any other machine. If you need a host-specific defcfg knob, add it to that
host's nix file as extraDefCfg -- not here.

What the layout does: Caps Lock is Caps on tap and Left Ctrl on hold; holding
Left Alt turns ijkl into arrows, with further tmux-navigation sublayers.
--------------------------------------------------------------------------- |#

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rctl left down up right
)

(deflayer default
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet @arrow           spc            ralt rctl left down up right
)

(deflayer arrowlayer
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @lft @dwn @upp @rgt _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  @tmux _ _ @tmuxnav _ _ @hm @pgd @pgu @nd
)

(deflayer tmuxnavlayer
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @tmuxnavl @tmuxnavd @tmuxnavu @tmuxnavr _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _
)

(deflayer tmuxlayer
  _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _ C-A-] C-A-\
  _ _ _ _ _ _ C-A-left C-A-down C-A-up C-A-right _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ @tmuxlw @tmuxdw @tmuxuw @tmuxrw
)

(defalias
  arrow (multi lalt (layer-while-held arrowlayer))
  lft (multi (release-key lalt) left) ;; release alt if held and also press left
  dwn (multi (release-key lalt) down)
  upp (multi (release-key lalt) up)
  rgt (multi (release-key lalt) rght) ;; release alt if held and also press rght
  tmuxnav (layer-while-held tmuxnavlayer)
  tmuxnavl (multi (release-key lalt) C-left)
  tmuxnavd (multi (release-key lalt) C-down)
  tmuxnavu (multi (release-key lalt) C-up)
  tmuxnavr (multi (release-key lalt) C-right)
  tmux (layer-while-held tmuxlayer)
  tmuxlw (multi (release-key lalt) S-left) ;; tmux left window
  tmuxdw (multi (release-key lalt) S-down) ;; tmux down window (kill)
  tmuxuw (multi (release-key lalt) S-up) ;; tmux up window (new)
  tmuxrw (multi (release-key lalt) S-right) ;; tmux right window
  hm (multi (release-key lalt) home)
  pgd (multi (release-key lalt) pgdn)
  pgu (multi (release-key lalt) pgup)
  nd (multi (release-key lalt) end)
)
