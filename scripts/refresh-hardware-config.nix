# scripts/refresh-hardware-config.nix
#
# `nix run .#refresh-hardware-config` -- regenerate
# hosts/<hostname>-hardware-configuration.nix from the machine you're
# sitting at, in place, and stage it.
#
# Those files are the output of `nixos-generate-config`, which NixOS runs
# once at install time and writes to /etc/nixos/hardware-configuration.nix.
# Nothing re-runs it afterwards, so after a mainboard swap (or a new disk,
# or just a nixpkgs bump that teaches the scanner a new option) the copy in
# this repo silently describes hardware that is no longer here.
#
# Two things rule out the obvious "just import /etc/nixos" shortcut:
#
#  - a flake can't read it. `import /etc/nixos/hardware-configuration.nix`
#    dies with "access to absolute path ... is forbidden in pure evaluation
#    mode". --impure would work, at the cost of `nix flake check`, remote
#    builds and any claim to reproducibility.
#  - the file has to be in the git tree. Nix evaluates the flake from the
#    git tree, not the working directory, so a freshly written *untracked*
#    file is invisible ("To make it visible to Nix, run: git add"). Hence
#    the `git add` at the end -- without it the first run looks like a
#    no-op.
#
# So it stays a tracked file, and this regenerates it on demand instead of
# by magic. nixos-generate-config comes from this flake's nixpkgs rather
# than /run/current-system, so the output matches the nixpkgs you are about
# to build with -- that's how `hardware.cpu.intel.npu.enable` shows up at
# all.
{ pkgs }:

pkgs.writeShellApplication {
  name = "refresh-hardware-config";
  runtimeInputs = with pkgs; [ coreutils diffutils git gnused nixos-install-tools ];
  text = ''
    check_only=false
    force=false
    host=""

    while [ "$#" -gt 0 ]; do
      case "$1" in
        --check) check_only=true ;;
        --force) force=true ;;
        -h|--help)
          echo "refresh-hardware-config [--check] [--force] [host]"
          echo
          echo "  host      which hosts/<host>-hardware-configuration.nix to write."
          echo "            Defaults to this machine's hostname."
          echo "  --check   report whether the file is stale and exit 1 if so; write nothing."
          echo "  --force   allow writing a host file whose name isn't this machine."
          exit 0
          ;;
        -*) echo "refresh-hardware-config: unknown flag $1" >&2; exit 2 ;;
        *)
          if [ -n "$host" ]; then
            echo "refresh-hardware-config: unexpected argument $1" >&2; exit 2
          fi
          host="$1"
          ;;
      esac
      shift
    done

    this_host=$(uname -n)
    host="''${host:-$this_host}"

    # The scan describes the machine it runs on, so writing some other
    # host's file from here would overwrite its hardware with this one's.
    if [ "$host" != "$this_host" ] && [ "$force" != true ]; then
      echo "refresh-hardware-config: refusing to write '$host' from '$this_host'." >&2
      echo "  The scan only describes the machine it runs on. Pass --force if you mean it." >&2
      exit 2
    fi

    repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    target="$repo/hosts/$host-hardware-configuration.nix"

    if [ ! -e "$target" ] && [ "$force" != true ]; then
      echo "refusing to create a new $target; pass --force to add a host." >&2
      exit 2
    fi

    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT

    # Replace the upstream 3-line header, which points at
    # /etc/nixos/configuration.nix -- not where anything in this repo lives.
    {
      echo "# Generated by \`nix run .#refresh-hardware-config\`"
      echo "# (scripts/refresh-hardware-config.nix) from the live hardware -- do not"
      echo "# hand-edit; put anything you want to keep in hosts/$host.nix instead."
      nixos-generate-config --show-hardware-config | tail -n +4
    } > "$tmp"

    if [ ! -e "$target" ]; then
      echo "$target does not exist yet; it will be created from this machine's scan."
    elif diff -q "$target" "$tmp" >/dev/null 2>&1; then
      echo "$target is already current."
      exit 0
    else
      diff -u --label "$target (tracked)" --label "$target (live hardware)" \
        "$target" "$tmp" || true
    fi

    if [ "$check_only" = true ]; then
      echo >&2
      echo "refresh-hardware-config: $target is stale (see diff above)." >&2
      exit 1
    fi

    cp "$tmp" "$target"
    # Untracked files are invisible to flake evaluation, so stage it.
    git -C "$repo" add -- "$target" 2>/dev/null \
      || echo "note: could not 'git add' $target; do it yourself or the flake won't see it." >&2
    echo
    echo "Wrote $target. Review it, then rebuild."
  '';
}
